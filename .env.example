APP_NAME="مزاد سوريا"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Hostinger Database Configuration (MySQL / MariaDB)
# -----------------------------------------------------------------------------
# على استضافة هوستنجر (Hostinger)، يتم إنشاء قاعدة البيانات من لوحة hPanel
# انسخ اسم القاعدة واسم المستخدم وكلمة المرور هنا:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_mazad
DB_USERNAME=u123456789_user
DB_PASSWORD=your_strong_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@your-domain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="support@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
